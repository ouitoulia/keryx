<?php

use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\keryx\Hook\BreadcrumbHooks;
use Drupal\keryx\Hook\DocumentoHooks;
use Drupal\keryx\Hook\ObbligoHooks;

/**
 * Implements hook_form_FORM_ID_form_alter().
 */
#[LegacyHook]
function keryx_form_node_form_alter(&$form, FormStateInterface $form_state) {
  return \Drupal::service(DocumentoHooks::class)->documentoFormAlter($form, $form_state);
}

/**
 * Implements hook_preprocess_breadcrumb().
 */
#[LegacyHook]
function keryx_preprocess_breadcrumb(&$variables) {
  return \Drupal::service(BreadcrumbHooks::class)->preprocessBreadcrumb($variables);
}

/**
 * Implements hook_preprocess_page().
 */
#[LegacyHook]
function keryx_preprocess_page(array &$variables) {
  return \Drupal::service(ObbligoHooks::class)->preprocessPage($variables);
}

/**
 * Implements hook_preprocess_taxonomy_term().
 */
#[LegacyHook]
function keryx_preprocess_taxonomy_term(&$variables) {
  return \Drupal::service(ObbligoHooks::class)->preprocessTaxonomyTerm($variables);
}

/**
 * Implements hook_preprocess_views_view().
 */
#[LegacyHook]
function keryx_preprocess_views_view(&$variables) {
  return \Drupal::service(ObbligoHooks::class)->preprocessViewsView($variables);
}

/**
 * Implements hook_template_preprocess_views_view_table().
 */
#[LegacyHook]
function keryx_preprocess_views_view_table(&$variables) {
  return \Drupal::service(ObbligoHooks::class)->preprocessViewsViewTable($variables);
}
